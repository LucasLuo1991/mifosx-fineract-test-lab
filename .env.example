TAG=latest

# Host ports used when running the stack locally or on Jenkins agents.
FINERACT_PORT=3000
WEB_APP_PORT=4200
POSTGRES_PORT=5432

# Optional host-facing service URL overrides. By default these are derived from
# FINERACT_PORT, WEB_APP_PORT, POSTGRES_PORT, and FINERACT_TENANT_DEFAULT_DB_NAME.
# SERVER_URL=http://localhost:3000
# WEB_APP_URL=http://localhost:4200
# DB_ENDPOINT=localhost:5432/fineract_default

# Optional API URL injected into the web app and used by the browser.
# Set this to http://fineract-server:8080 when running Playwright inside the test-runner container.
# WEB_APP_FINERACT_API_URL=http://localhost:3000

# API test credentials.
API_USER=mifos
API_PASS=password

# Database and tenant values shared by Fineract and the test runner.
POSTGRES_USER=root
POSTGRES_PASSWORD=superuser_secure_password_here
POSTGRES_DB=postgres
FINERACT_DB_USER=postgres
FINERACT_DB_PASS=your_secure_password_here
FINERACT_TENANTS_DB_NAME=fineract_tenants
FINERACT_TENANT_DEFAULT_DB_NAME=fineract_default
TENANT_ID=default

# Scalable manager-worker configuration.
FINERACT_MANAGER_MODE=WRITE
FINERACT_WORKER_MODE=READ
FINERACT_WORKERS_COUNT=0

# Messaging and external services.
FINERACT_MESSAGING_ACTIVEMQ_BROKER_URL=tcp://activemq:61616
FINERACT_REPORT_ENGINE_BIRT_ENABLED=true
