    {
      "name": "Create active client",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let mobileNumber = pm.collectionVariables.get(\"mobileNo\");\r",
              "\r",
              "if (!mobileNumber || !mobileNumber.startsWith(\"+61\")) {\r",
              "    mobileNumber = \"+614\" + String(Math.floor(Math.random() * 100000000)).padStart(8, \"0\");\r",
              "} else {\r",
              "    const nextPhoneNumber = Number(mobileNumber.substring(3)) + 1;\r",
              "    const paddedLocalNumber = String(nextPhoneNumber).padStart(9, \"0\");\r",
              "    mobileNumber = \"+61\" + paddedLocalNumber;\r",
              "}\r",
              "\r",
              "pm.collectionVariables.set(\"mobileNo\", mobileNumber);\r",
              "\r",
              "function getRandomId(variableName, options = {}) {\r",
              "    const rawLookupMap = pm.collectionVariables.get(variableName);\r",
              "    const idLookupMap = rawLookupMap ? JSON.parse(rawLookupMap) : {};\r",
              "    const availableIds = Object.keys(idLookupMap);\r",
              "\r",
              "    if (availableIds.length === 0) {\r",
              "        if (options.required) {\r",
              "            throw new Error(`${variableName} has no IDs. Run the lookup setup request before this request.`);\r",
              "        }\r",
              "\r",
              "        return null;\r",
              "    }\r",
              "\r",
              "    return Number(availableIds[Math.floor(Math.random() * availableIds.length)]);\r",
              "}\r",
              "\r",
              "const randomGenderId = getRandomId(\"genderIdNameMap\");\r",
              "const randomStaffId = getRandomId(\"staffIdDisplayNameMap\");\r",
              "const randomOfficeId = getRandomId(\"officeIdNameMap\", { required: true });\r",
              "\r",
              "const clientDetails = {\r",
              "    activationDate: \"04 March 2026\",\r",
              "    active: true,\r",
              "    address: [\r",
              "        {\r",
              "            addressLine1: pm.variables.replaceIn(\"{{$randomStreetAddress}}\"),\r",
              "            addressLine2: \"Automation Quarter\",\r",
              "            addressTypeId: 1,\r",
              "            city: \"Sydney\",\r",
              "            countryId: 1,\r",
              "            isActive: true,\r",
              "            postalCode: \"2000\",\r",
              "            stateProvinceId: 1\r",
              "        }\r",
              "    ],\r",
              "    dateFormat: \"dd MMMM yyyy\",\r",
              "    dateOfBirth: \"07 March 1990\",\r",
              "    emailAddress: pm.variables.replaceIn(\"sample.client{{$timestamp}}@example.com\"),\r",
              "    externalId: pm.variables.replaceIn(\"CLIENT-{{$timestamp}}\"),\r",
              "    firstname: pm.variables.replaceIn(\"{{$randomFirstName}}\"),\r",
              "    lastname: pm.variables.replaceIn(\"{{$randomLastName}}\"),\r",
              "    legalFormId: 1,\r",
              "    locale: \"en\",\r",
              "    mobileNo: mobileNumber,\r",
              "    officeId: randomOfficeId,\r",
              "    submittedOnDate: \"01 March 2024\"\r",
              "};\r",
              "\r",
              "if (randomGenderId !== null) {\r",
              "    clientDetails.genderId = randomGenderId;\r",
              "}\r",
              "\r",
              "if (randomStaffId !== null) {\r",
              "    clientDetails.staffId = randomStaffId;\r",
              "}\r",
              "\r",
              "pm.request.body.update(JSON.stringify(clientDetails));\r"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let createClientResponse;\r",
              "\r",
              "pm.test('returns HTTP 200', function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test('returns a valid JSON object', function () {\r",
              "    createClientResponse = pm.response.json();\r",
              "    pm.expect(createClientResponse).to.be.an('object');\r",
              "    pm.expect(createClientResponse).to.not.be.null;\r",
              "});\r",
              "\r",
              "pm.test('Create client response includes key identifiers', function () {\r",
              "    pm.expect(createClientResponse).to.have.property('officeId');\r",
              "    pm.expect(createClientResponse).to.have.property('clientId');\r",
              "    pm.expect(createClientResponse).to.have.property('resourceId');\r",
              "    pm.expect(createClientResponse).to.have.property('resourceExternalId');\r",
              "});\r",
              "\r",
              "pm.test('Create client identifiers are valid', function () {\r",
              "    pm.expect(createClientResponse.officeId).to.be.a('number');\r",
              "    pm.expect(createClientResponse.officeId).to.be.above(0);\r",
              "    pm.expect(createClientResponse.clientId).to.be.a('number');\r",
              "    pm.expect(createClientResponse.clientId).to.be.above(0);\r",
              "    pm.expect(createClientResponse.resourceId).to.be.a('number');\r",
              "    pm.expect(createClientResponse.resourceId).to.be.above(0);\r",
              "    pm.expect(createClientResponse.resourceExternalId).to.be.a('string');\r",
              "    pm.expect(createClientResponse.resourceExternalId).to.not.be.empty;\r",
              "});\r",
              "\r",
              "pm.test('Resource ID matches created client ID', function () {\r",
              "    pm.expect(createClientResponse.resourceId).to.eql(createClientResponse.clientId);\r",
              "    pm.collectionVariables.set(\"clientId\", createClientResponse.clientId);\r",
              "});\r",
              "\r",
              "pm.test('Resource external ID uses client prefix', function () {\r",
              "    pm.expect(createClientResponse.resourceExternalId).to.match(/^CLIENT-/);\r",
              "});\r",
              "\r",
              "if (pm.response.code === 200) {\r",
              "    const clientDetails = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));\r",
              "    pm.collectionVariables.set(\"clientDetails\", JSON.stringify(clientDetails));\r",
              "}\r"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
