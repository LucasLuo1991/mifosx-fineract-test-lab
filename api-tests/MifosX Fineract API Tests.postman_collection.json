              "    pm.expect(createUserResponse).to.not.be.null;\r",
              "});\r",
              "\r",
              "pm.test('Create user response includes key identifiers', function () {\r",
              "    pm.expect(createUserResponse).to.have.property('officeId');\r",
              "    pm.expect(createUserResponse).to.have.property('resourceId');\r",
              "});\r",
