    {
      "name": "Get created user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let getUserResponse;\r",
              "let userDetails;\r",
              "\r",
              "pm.test('returns HTTP 200', function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test('returns a valid JSON object', function () {\r",
              "    getUserResponse = pm.response.json();\r",
              "    pm.expect(getUserResponse).to.be.an('object');\r",
              "    pm.expect(getUserResponse).to.not.be.null;\r",
              "});\r",
              "\r",
              "pm.test('Saved user request details exist', function () {\r",
              "    userDetails = JSON.parse(pm.collectionVariables.get('userDetails'));\r",
              "    pm.expect(userDetails).to.be.an('object');\r",
              "});\r",
              "\r",
              "function expectFieldsToMatchResponse(fields) {\r",
              "    fields.forEach((field) => {\r",
              "        pm.expect(getUserResponse[field], `${field} should match`).to.eql(userDetails[field]);\r",
              "    });\r",
              "}\r",
              "\r",
              "pm.test('Created user ID matches requested user ID', function () {\r",
              "    const requestedUserId = Number(pm.collectionVariables.get('userId'));\r",
              "\r",
              "    pm.expect(getUserResponse.id).to.be.a('number');\r",
              "    pm.expect(getUserResponse.id).to.be.above(0);\r",
              "    pm.expect(getUserResponse.id).to.eql(requestedUserId);\r",
              "});\r",
              "\r",
              "pm.test('Created user details match request body', function () {\r",
              "    expectFieldsToMatchResponse([\r",
              "        'username',\r",
              "        'firstname',\r",
              "        'lastname',\r",
              "        'email',\r",
              "        'officeId',\r",
              "        'passwordNeverExpires'\r",
              "    ]);\r",
              "});\r",
              "\r",
              "pm.test('Created user selected roles match request body', function () {\r",
              "    pm.expect(getUserResponse.selectedRoles).to.be.an('array');\r",
              "    const selectedRoleIds = getUserResponse.selectedRoles.map((role) => role.id);\r",
              "\r",
              "    userDetails.roles.forEach((roleId) => {\r",
              "        pm.expect(selectedRoleIds).to.include(roleId);\r",
              "    });\r",
              "});\r",
              "\r",
              "if (getUserResponse && getUserResponse.id) {\r",
              "    pm.collectionVariables.set('userId', String(getUserResponse.id));\r",
              "}\r"
            ],
