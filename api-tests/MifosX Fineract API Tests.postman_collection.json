          "script": {
            "exec": [
              "let staffMembers;\r",
              "\r",
              "pm.test(\"returns HTTP 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response body is valid JSON\", function () {\r",
              "    staffMembers = pm.response.json();\r",
              "    pm.expect(staffMembers).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains active staff members\", function () {\r",
              "    pm.expect(staffMembers).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Staff members include ID and display name\", function () {\r",
              "    staffMembers.forEach(function (staffMember) {\r",
              "        pm.expect(staffMember).to.be.an(\"object\");\r",
              "        pm.expect(staffMember).to.have.property(\"id\");\r",
