  "item": [
    {
      "name": "Authenticate user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"returns HTTP 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "let authResponse;\r",
              "pm.test(\"Response body is a valid JSON object\", function () {\r",
              "    authResponse = pm.response.json();\r",
              "    pm.expect(authResponse).to.be.an(\"object\");\r",
              "});\r",
              "\r",
              "pm.test(\"Authenticates the requested user\", function () {\r",
              "    pm.expect(authResponse.authenticated).to.be.true;\r",
              "});\r",
              "\r",
              "pm.test(\"Authentication response includes username\", function () {\r",
              "    pm.expect(authResponse.username).to.be.a(\"string\").and.not.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"Authentication response username matches request username\", function () {\r",
              "    pm.expect(authResponse.username).to.eql(String(pm.variables.get(\"username\")).replace(/^\"|\"$/g, \"\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Authentication response includes access token\", function () {\r",
              "    pm.expect(authResponse.base64EncodedAuthenticationKey).to.be.a(\"string\").and.not.empty;\r",
              "});\r",
              "\r",
              "if (authResponse && authResponse.base64EncodedAuthenticationKey) {\r",
              "    pm.collectionVariables.set(\"accessToken\", authResponse.base64EncodedAuthenticationKey);\r",
              "}\r"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "{{tenantKey}}",
            "value": "{{tenantId}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"{{username}}\",\r\n    \"password\": \"{{password}}\"\r\n}",
          "options": {
