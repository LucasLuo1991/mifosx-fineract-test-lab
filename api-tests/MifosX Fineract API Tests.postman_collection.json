    {
      "name": "Create new user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function getRandomId(variableName) {\r",
              "    const rawLookupMap = pm.collectionVariables.get(variableName);\r",
              "    const idLookupMap = rawLookupMap ? JSON.parse(rawLookupMap) : {};\r",
              "    const availableIds = Object.keys(idLookupMap);\r",
              "\r",
              "    if (availableIds.length === 0) {\r",
              "        throw new Error(`${variableName} has no IDs. Run the lookup setup request before this request.`);\r",
              "    }\r",
              "\r",
              "    return Number(availableIds[Math.floor(Math.random() * availableIds.length)]);\r",
              "}\r",
              "\r",
              "const randomOfficeId = getRandomId(\"officeIdNameMap\");\r",
              "const randomRoleId = getRandomId(\"roleIdNameMap\");\r",
              "const password = pm.collectionVariables.get(\"newUserPassword\") || \"MifosTest7@Q\";\r",
              "\r",
              "const userDetails = {\r",
              "    email: pm.variables.replaceIn(\"whatever.{{$timestamp}}@mifos.org\"),\r",
              "    firstname: \"Test\",\r",
              "    isLoginRetriesEnabled: true,\r",
              "    isPasswordResetAllowed: true,\r",
              "    lastname: \"User\",\r",
              "    officeId: randomOfficeId,\r",
              "    password,\r",
              "    passwordNeverExpires: true,\r",
              "    repeatPassword: password,\r",
              "    roles: [randomRoleId],\r",
              "    sendPasswordToEmail: false,\r",
              "    username: pm.variables.replaceIn(\"newuser{{$timestamp}}\")\r",
              "};\r",
              "\r",
              "pm.request.body.update(JSON.stringify(userDetails));\r"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
