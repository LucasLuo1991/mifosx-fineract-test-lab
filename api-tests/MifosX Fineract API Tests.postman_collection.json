    {
      "name": "Get created client",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"returns HTTP 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "let clientResponse;\r",
              "pm.test(\"Response body is a valid JSON object\", function () {\r",
              "    clientResponse = pm.response.json();\r",
              "    pm.expect(clientResponse).to.be.an(\"object\");\r",
              "});\r",
              "\r",
              "let clientDetails;\r",
              "pm.test(\"Saved client request details exist\", function () {\r",
              "    clientDetails = JSON.parse(pm.collectionVariables.get(\"clientDetails\"));\r",
              "    pm.expect(clientDetails).to.be.an(\"object\");\r",
              "});\r",
              "\r",
              "function fineractDateToString(dateArray) {\r",
              "    const [year, month, day] = dateArray;\r",
              "    const date = new Date(year, month - 1, day);\r",
              "\r",
              "    return date.toLocaleDateString(\"en-GB\", {\r",
              "        day: \"2-digit\",\r",
              "        month: \"long\",\r",
              "        year: \"numeric\"\r",
              "    });\r",
              "}\r",
              "\r",
              "pm.test(\"Created client is active\", function () {\r",
              "    pm.expect(clientResponse.active).to.eql(clientDetails.active);\r",
              "    pm.expect(clientResponse.status.value).to.eql(\"Active\");\r",
              "});\r",
              "\r",
              "pm.test(\"Created client name matches request body\", function () {\r",
              "    pm.expect(clientResponse.firstname).to.eql(clientDetails.firstname);\r",
              "    pm.expect(clientResponse.lastname).to.eql(clientDetails.lastname);\r",
              "    pm.expect(clientResponse.displayName).to.eql(`${clientDetails.firstname} ${clientDetails.lastname}`);\r",
              "});\r",
              "\r",
              "pm.test(\"Created client contact details match request body\", function () {\r",
              "    pm.expect(clientResponse.mobileNo).to.eql(clientDetails.mobileNo);\r",
              "    pm.expect(clientResponse.emailAddress).to.eql(clientDetails.emailAddress);\r",
              "});\r",
              "\r",
              "pm.test(\"Created client external ID matches request body\", function () {\r",
              "    pm.expect(clientResponse.externalId).to.eql(clientDetails.externalId);\r",
              "});\r",
              "\r",
              "pm.test(\"Created client office, staff, gender and legal form match request body\", function () {\r",
              "    pm.expect(clientResponse.officeId).to.eql(clientDetails.officeId);\r",
              "\r",
              "    if (clientDetails.staffId !== undefined) {\r",
              "        pm.expect(clientResponse.staffId).to.eql(clientDetails.staffId);\r",
              "    }\r",
              "\r",
              "    if (clientDetails.genderId !== undefined) {\r",
              "        pm.expect(clientResponse.gender.id).to.eql(clientDetails.genderId);\r",
              "    }\r",
              "\r",
              "    pm.expect(clientResponse.legalForm.id).to.eql(clientDetails.legalFormId);\r",
              "});\r",
              "\r",
              "pm.test(\"Created client dates match request body\", function () {\r",
              "    pm.expect(fineractDateToString(clientResponse.activationDate)).to.eql(clientDetails.activationDate);\r",
              "    pm.expect(fineractDateToString(clientResponse.dateOfBirth)).to.eql(clientDetails.dateOfBirth);\r",
              "    pm.expect(fineractDateToString(clientResponse.timeline.submittedOnDate)).to.eql(clientDetails.submittedOnDate);\r",
              "});\r"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
