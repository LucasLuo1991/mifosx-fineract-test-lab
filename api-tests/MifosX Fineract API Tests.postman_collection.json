      "name": "List gender code values",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let genderCodeValues;\r",
              "\r",
              "pm.test(\"returns HTTP 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response body is valid JSON\", function () {\r",
              "    genderCodeValues = pm.response.json();\r",
              "    pm.expect(genderCodeValues).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains gender code values\", function () {\r",
              "    pm.expect(genderCodeValues).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Gender code values include ID and name\", function () {\r",
              "    genderCodeValues.forEach(function (genderCodeValue) {\r",
              "        pm.expect(genderCodeValue).to.be.an(\"object\");\r",
              "        pm.expect(genderCodeValue).to.have.property(\"id\");\r",
              "        pm.expect(genderCodeValue).to.have.property(\"name\");\r",
              "    });\r",
              "});\r",
              "\r",
              "const genderIdNameMap = {};\r",
              "\r",
              "if (Array.isArray(genderCodeValues)) {\r",
              "    genderCodeValues.forEach(function (genderCodeValue) {\r",
              "        if (genderCodeValue && genderCodeValue.id !== undefined && genderCodeValue.name !== undefined) {\r",
              "            genderIdNameMap[genderCodeValue.id] = genderCodeValue.name;\r",
              "        }\r",
              "    });\r",
              "}\r",
              "\r",
              "pm.collectionVariables.set(\"genderIdNameMap\", JSON.stringify(genderIdNameMap));\r"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
