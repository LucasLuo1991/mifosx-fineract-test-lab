              "    pm.expect(createUserResponse.officeId).to.be.a('number');\r",
              "    pm.expect(createUserResponse.officeId).to.be.above(0);\r",
              "    pm.expect(createUserResponse.resourceId).to.be.a('number');\r",
              "    pm.expect(createUserResponse.resourceId).to.be.above(0);\r",
              "});\r",
              "\r",
